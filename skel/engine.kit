class engine_nodes{
    public $app_html; 

    function load_html(string $html){
        $this->app_html = $html; 
    } 

    function extract($tag,$tag_end){
        $e = $this->extract_nodes($this->app_html,$tag,$tag_end); 
        return $e;
    }

    function extract_nodes($html,$node_opening,$node_closing){
        
        $startMarker = preg_quote($node_opening, '/');
        $endMarker   = preg_quote($node_closing, '/');

        $pattern = '/' . $startMarker . '(.*?)' . $endMarker . '/s';

        if (preg_match($pattern, $html, $matches)) {
            return $matches[1]; // Returns the captured content inside the markers
        }

        return null;

    }
}

# How To Use
$engine = new engine_nodes(); 
$engine->load_html($file_contents); 

# Get The header
$header = $engine->extract(
    '<!-- #/engine/head/encode/:BEGIN -->',
    '<!-- #/engine/head/encode/:END; -->'); 

# Get The Navbar 
$navbar = $engine->extract(
    '<!-- #/engine/navbar/encode/:BEGIN -->',
    '<!-- #/engine/navbar/encode/:END; -->'); 

#Get The Body 
$body = $engine->extract(
    '<!-- #/engine/body/encode/:BEGIN -->',
    '<!-- #/engine/body/encode/:END; -->'); 

# Replace The Navbar Scripts 
$file_contents = str_ireplace(
    '<!-- #/engine/navbar/encode/:BEGIN -->'.$navbar.'<!-- #/engine/navbar/encode/:END; -->',
    '# $app()->card(navbar);',
    $file_contents);

# Replace The Body Scripts 
$file_contents = str_ireplace(
    '<!-- #/engine/body/encode/:BEGIN -->'.$body.'<!-- #/engine/body/encode/:END; -->',
    '# $app()->page(e); ',
    $file_contents);

# Replace The PHP Scripts Tag
$file_contents = str_ireplace(
    '<?php',
    '<!-- #!/engine/node/',
    $file_contents);

$file_contents = str_ireplace(
    '<?=',
    '<!-- #!/engine/node/ echo',
    $file_contents);

$file_contents = str_ireplace(
    '?>',
    '-->',
    $file_contents);

